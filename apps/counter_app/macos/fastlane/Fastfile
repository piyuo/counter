# macos/fastlane/Fastfile

default_platform(:mac)

platform :mac do
  desc "Push a new release build to the Apple App Store(macos)"
  lane :release do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"]
    )

    # 1. Path pointing to the project root relative to macos/fastlane/
    build_num_file = "../../.build_number"

    # 2. Read the current tracking number or start at 0 if it doesn't exist
    if File.exist?(build_num_file)
      current_build = File.read(build_num_file).strip.to_i
    else
      current_build = 0
    end

    # 3. Increment the counter
    next_build_number = current_build + 1
    UI.message("Shared Global Build Number: #{current_build} ──> Incrementing to: #{next_build_number}")

    # 4. Save the new build number back to the root text file immediately
    File.write(build_num_file, next_build_number.to_s)

    # 5. Inject the build number into your macOS Xcode project configurations
    increment_build_number(
      xcodeproj: "Counter.xcodeproj",
      build_number: next_build_number
    )

    # 6. Build the app with the newly incremented build number
    build_app(
      workspace: "Counter.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    # 7. Upload the app to App Store Connect
    upload_to_app_store(
      precheck_include_in_app_purchases: false
    )
  end
end