# macos/fastlane/Fastfile

default_platform(:mac)

platform :mac do
  desc "Push a new release build to the Apple App Store (macOS)"
  lane :release do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"]
    )

    # Path pointing to the project root relative to macos/fastlane/
    build_num_file = "../../.build_number_macos"

    # Read the current tracking number or start at 0 if it doesn't exist
    if File.exist?(build_num_file)
      current_build = File.read(build_num_file).strip.to_i
    else
      current_build = 0
    end

    # Increment the counter
    next_build_number = current_build + 1

    # Inject the build number into the Xcode project configurations
    increment_build_number(
      xcodeproj: "Counter.xcodeproj",
      build_number: next_build_number
    )

    # Build the app with the newly incremented build number.
    # Keep the archive so its exact dSYMs can be uploaded to Sentry.
    build_app(
      workspace: "Counter.xcworkspace",
      scheme: "Runner",
      archive_path: "../build/macos/Counter.xcarchive",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.piyuo.counter" => "macOS App Store Connect"
        }
      }
    )

    # Upload the exact archive to App Store Connect
    upload_to_app_store(
      submit_for_review: true,
      precheck_include_in_app_purchases: false,
      support_url: {
        'default' => 'https://piyuo.com'
      },
      copyright: "#{Time.now.year} Chien-Chih Liu"
    )

    # Save the new build number back to the root text file
    File.write(build_num_file, next_build_number.to_s)

    UI.message(
      "Shared Global Build Number: #{current_build} ──> Incrementing to: #{next_build_number}"
    )
  end
end