{
  "plugins": [
    "dart-workspace",
    {
      "type": "linked-versions",
      "groupName": "piyuo-counter-workspace",
      "components": [
        "apps/counter_app",
        "packages/core_domain",
        "packages/core_runtime",
        "packages/feature_control_panel",
        "packages/feature_monitor",
        "packages/feature_onboarding",
        "packages/feature_pip",
        "packages/shared_l10n"
      ]
    }
  ],
  "packages": {
    "apps/counter_app": {
      "release-type": "dart",
      "package-name": "counter_app",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/core_domain": {
      "release-type": "dart",
      "package-name": "core_domain"
    },
    "packages/core_runtime": {
      "release-type": "dart",
      "package-name": "core_runtime"
    },
    "packages/feature_control_panel": {
      "release-type": "dart",
      "package-name": "feature_control_panel"
    },
    "packages/feature_monitor": {
      "release-type": "dart",
      "package-name": "feature_monitor"
    },
    "packages/feature_onboarding": {
      "release-type": "dart",
      "package-name": "feature_onboarding"
    },
    "packages/feature_pip": {
      "release-type": "dart",
      "package-name": "feature_pip"
    },
    "packages/shared_l10n": {
      "release-type": "dart",
      "package-name": "shared_l10n"
    }
  }
}
