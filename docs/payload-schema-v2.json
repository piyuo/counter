{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piyuo.com/schema/payload-schema-v2.json",
  "title": "Piyuo Counter Payload",
  "description": "Schema 2 payload generated by Piyuo Counter. Uploads contain 5-minute observations.",
  "type": "object",
  "required": ["schema", "deviceId", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2,
      "title": "Schema Version"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "title": "Device ID"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "title": "Project ID"
    },
    "assignId": {
      "type": "string",
      "minLength": 1,
      "title": "Assignment ID"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Observation"
      }
    }
  },
  "$defs": {
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "confidenceRatioSum",
        "confidenceSampleCount",
        "confidenceRatio",
        "coveredSeconds",
        "expectedSeconds",
        "coverageRatio",
        "areas",
        "frameCount"
      ],
      "properties": {
        "granularity": {
          "type": "string",
          "const": "minutes5",
          "description": "Aggregation interval. Schema 2 uploads contain 5-minute observations only."
        },
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999,
          "description": "Four-digit business-local year."
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Business-local month."
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Business-local day of month."
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Business-local hour."
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 55,
          "multipleOf": 5,
          "description": "Starting minute of the 5-minute observation window."
        },
        "confidenceRatioSum": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of tracked-object confidence ratios, each in the range 0 to 1."
        },
        "confidenceSampleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of confidence samples."
        },
        "confidenceRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Mean confidence ratio, rounded to at most two decimal places when serialized."
        },
        "coveredSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds with valid detection data."
        },
        "expectedSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Expected duration of the observation in seconds; normally 300."
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Covered seconds divided by expected seconds, rounded to at most two decimal places."
        },
        "areas": {
          "type": "array",
          "description": "Metrics for the Global area and configured interest areas. Area IDs must be unique within an observation.Must contain the Global area with areaId 0.",
          "items": {
            "$ref": "#/$defs/Area"
          },
          "contains": {
            "type": "object",
            "required": ["areaId"],
            "properties": {
              "areaId": {
                "const": 0
              }
            }
          },
          "minContains": 1
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of processed frames."
        }
      }
    },
    "Area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaId",
        "areaName",
        "passBy",
        "stagnant",
        "entry",
        "exit",
        "appear",
        "disappear",
        "occupancySampleCount",
        "occupancySampleSum",
        "occupancySampleSumSquares",
        "occupancyMean",
        "occupancyMax",
        "occupancyLast",
        "dwellSumSeconds",
        "dwellSampleCount",
        "dwellMeanSeconds",
        "dwellMaxSeconds",
        "dwellHistogram",
        "presenceTrackCount",
        "presenceSumSeconds",
        "presenceMeanSeconds"
      ],
      "properties": {
        "areaId": {
          "type": "integer",
          "minimum": 0,
          "description": "Area identifier. Zero represents the Global area."
        },
        "areaName": {
          "type": "string",
          "description": "Configured area name."
        },
        "passBy": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks counted on first contact with the area."
        },
        "stagnant": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks reaching the configured stagnant threshold."
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks first observed outside and later inside a local area. Always zero for Global."
        },
        "exit": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks first observed inside and later outside a local area. Always zero for Global."
        },
        "appear": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks first detected with their center inside the area."
        },
        "disappear": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks last seen inside the area and subsequently absent long enough to meet the disappear threshold."
        },
        "occupancySampleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of occupancy samples."
        },
        "occupancySampleSum": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of occupancy samples."
        },
        "occupancySampleSumSquares": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of squared occupancy samples."
        },
        "occupancyMean": {
          "type": "number",
          "minimum": 0,
          "description": "Mean occupancy per sample, rounded to at most two decimal places."
        },
        "occupancyMax": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum occupancy sample."
        },
        "occupancyLast": {
          "type": "integer",
          "minimum": 0,
          "description": "Most recent occupancy sample."
        },
        "dwellSumSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of completed visit durations in whole seconds."
        },
        "dwellSampleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of completed visits."
        },
        "dwellMeanSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Mean completed visit duration in seconds, rounded to at most two decimal places."
        },
        "dwellMaxSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Longest completed visit in whole seconds."
        },
        "dwellHistogram": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Completed visit counts in [0,5), [5,15), [15,60), [60,300), and [300,infinity) second buckets."
        },
        "presenceTrackCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tracks present for a positive duration during this observation."
        },
        "presenceSumSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Total track-seconds spent inside the area, rounded to whole seconds."
        },
        "presenceMeanSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Mean presence duration per present track, rounded to at most two decimal places."
        }
      }
    }
  }
}
