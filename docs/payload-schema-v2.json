{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piyuo.com/schema/payload-schema-v2.json",
  "title": "Piyuo Counter Payload",
  "description": "Hourly upload payload generated by Piyuo Counter.",
  "type": "object",
  "required": ["schema", "deviceId", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2,
      "title": "Schema Version",
      "examples": [2]
    },
    "deviceId": {
      "type": "string",
      "title": "Device ID"
    },
    "projectId": {
      "type": "string",
      "title": "Project ID"
    },
    "assignId": {
      "type": "string",
      "title": "Assignment ID"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Observation"
      }
    }
  },
  "$defs": {
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granularity",
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "confidenceRatioSum",
        "confidenceSampleCount",
        "coveredSeconds",
        "expectedSeconds",
        "areas",
        "frameCount"
      ],
      "properties": {
        "granularity": {
          "type": "string",
          "const": "minutes5",
          "description": "Aggregation interval represented by an uploaded payload."
        },
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999,
          "description": "Four-digit business year."
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Business month."
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Business day of month."
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Business hour."
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59,
          "description": "Business minute."
        },
        "confidenceRatioSum": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of tracked-object confidence ratios, each from 0 to 1."
        },
        "confidenceSampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "confidenceRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Average tracked-object confidence as a ratio from 0 to 1, rounded to at most 2 decimal places when serialized."
        },
        "coveredSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "expectedSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of the observation period with valid detection data, rounded to at most 2 decimal places when serialized."
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Area"
          }
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaId",
        "areaName",
        "passBy",
        "stagnant",
        "entry",
        "exit",
        "appear",
        "disappear",
        "occupancySampleCount",
        "occupancySampleSum",
        "occupancyMax",
        "occupancyLast",
        "dwellSumSeconds",
        "dwellSampleCount",
        "dwellMaxSeconds"
      ],
      "properties": {
        "areaId": {
          "type": "integer",
          "minimum": 0
        },
        "areaName": {
          "type": "string"
        },
        "passBy": {
          "type": "integer",
          "minimum": 0
        },
        "stagnant": {
          "type": "integer",
          "minimum": 0
        },
        "entry": {
          "type": "integer",
          "minimum": 0
        },
        "exit": {
          "type": "integer",
          "minimum": 0
        },
        "appear": {
          "type": "integer",
          "minimum": 0
        },
        "disappear": {
          "type": "integer",
          "minimum": 0
        },
        "occupancySampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "occupancySampleSum": {
          "type": "integer",
          "minimum": 0
        },
        "occupancyAvg": {
          "type": "number",
          "minimum": 0,
          "description": "Average occupancy across occupancy samples, rounded to at most 2 decimal places when serialized."
        },
        "occupancyMax": {
          "type": "integer",
          "minimum": 0
        },
        "occupancyLast": {
          "type": "integer",
          "minimum": 0
        },
        "dwellSumSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "dwellSampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "dwellAvgSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Average dwell duration in seconds, rounded to at most 2 decimal places when serialized."
        },
        "dwellMaxSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
