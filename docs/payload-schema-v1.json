{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piyuo.com/schema/payload-schema-v1.json",
  "title": "Piyuo Counter Payload",
  "description": "Hourly upload payload generated by Piyuo Counter.",
  "type": "object",
  "required": [
    "schema",
    "deviceId",
    "payloads"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1,
      "title": "Schema Version",
      "description": "Payload schema version.",
      "examples": [
        1
      ]
    },
    "deviceId": {
      "type": "string",
      "title": "Device ID",
      "description": "Unique identifier of the device.",
      "examples": [
        "041bfec6-8923-4b09-be5f-0fd11d3df7f5"
      ]
    },
    "projectId": {
      "type": "string",
      "title": "Project ID",
      "description": "Optional project identifier.",
      "examples": [
        "project-001"
      ]
    },
    "assignId": {
      "type": "string",
      "title": "Assignment ID",
      "description": "Optional assignment identifier.",
      "examples": [
        "assign-001"
      ]
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Payload"
      }
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "sequence",
        "startUtc",
        "startBusiness",
        "businessDate",
        "frameCount",
        "missingSec",
        "confidence",
        "isPartial",
        "coverage",
        "fps",
        "areas"
      ],
      "properties": {
        "session": {
          "type": "string",
          "title": "Session",
          "examples": [
            "2607131922"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1
          ]
        },
        "startUtc": {
          "type": "string",
          "format": "date-time",
          "examples": [
            "2026-07-14T02:20:00.000Z"
          ]
        },
        "startBusiness": {
          "type": "string",
          "examples": [
            "2026-07-13T19:20:00.000"
          ]
        },
        "businessDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "examples": [
            "2026-07-13"
          ]
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            7511
          ]
        },
        "missingSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "examples": [
            5
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "examples": [
            85.66
          ]
        },
        "isPartial": {
          "type": "boolean",
          "examples": [
            false
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "examples": [
            0.98
          ]
        },
        "fps": {
          "type": "number",
          "minimum": 0,
          "examples": [
            25.5
          ]
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Area"
          }
        }
      }
    },
    "Area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaId",
        "areaName",
        "passBy",
        "stay",
        "entry",
        "exit",
        "appear",
        "disappear",
        "avgOccupancy",
        "maxOccupancy",
        "avgDwellSec",
        "maxDwellSec"
      ],
      "properties": {
        "areaId": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            0
          ]
        },
        "areaName": {
          "type": "string",
          "examples": [
            "Global"
          ]
        },
        "passBy": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            12
          ]
        },
        "stay": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            3
          ]
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            5
          ]
        },
        "exit": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            4
          ]
        },
        "appear": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            2
          ]
        },
        "disappear": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            2
          ]
        },
        "avgOccupancy": {
          "type": "number",
          "minimum": 0,
          "examples": [
            1.32
          ]
        },
        "maxOccupancy": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            4
          ]
        },
        "avgDwellSec": {
          "type": "number",
          "minimum": 0,
          "examples": [
            87.6
          ]
        },
        "maxDwellSec": {
          "type": "number",
          "minimum": 0,
          "examples": [
            243.0
          ]
        }
      }
    }
  },
  "examples": [
    {
      "schema": 1,
      "deviceId": "041bfec6-8923-4b09-be5f-0fd11d3df7f5",
      "payloads": [
        {
          "session": "2607131922",
          "sequence": 1,
          "startUtc": "2026-07-14T02:20:00.000Z",
          "startBusiness": "2026-07-13T19:20:00.000",
          "businessDate": "2026-07-13",
          "frameCount": 2963,
          "missingSec": 177,
          "confidence": 86.92,
          "isPartial": true,
          "coverage": 0.41,
          "fps": 24.2,
          "areas": [
            {
              "areaId": 0,
              "areaName": "Global",
              "passBy": 1,
              "stay": 0,
              "entry": 0,
              "exit": 0,
              "appear": 0,
              "disappear": 0,
              "avgOccupancy": 0.99,
              "maxOccupancy": 1,
              "avgDwellSec": 60.7,
              "maxDwellSec": 122.0
            }
          ]
        }
      ]
    }
  ]
}